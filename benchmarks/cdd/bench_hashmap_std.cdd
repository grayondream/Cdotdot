// stdlib benchmark: std::HashMap<uint32,int32>, 2M puts + 2M gets.
// Pair: benchmarks/cpp/bench_hashmap_std.cpp (same algorithm and result).
module bench_hashmap_std;

import std.hashmap;
import std.hash;

int32 main() {
    std::HashMap<uint32, int32> m = {};
    m.init(std::hash_key_u32, std::equal_u32);
    int32 ops = 4000000;
    uint32* probe = (uint32*)malloc(ops * 4);
    uint32 seed = 987654321;
    for (int32 i = 0; i < ops; i = i + 1) {
        seed = seed * 1664525 + 1013904223;
        probe[i] = seed;
        m.put(seed, i);
    }
    int64 sum = 0;
    for (int32 i = 0; i < ops; i = i + 1) {
        seed = seed * 1664525 + 1013904223;
        uint32 key = probe[i];
        if ((i & 1) != 0) {
            key = seed;
        }
        int32 out = 0;
        if (m.get(key, &out)) {
            sum = sum + static_cast<int64>(out);
        }
    }
    println("{}", sum);
    m.destroy();
    free(probe);
    return 0;
}
