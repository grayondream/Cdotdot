// Runtime benchmark: float64 arithmetic with data-dependent branches.
// Pair: benchmarks/cpp/bench_mandelbrot.cpp (same algorithm and result).
module bench_mandelbrot;

int32 main() {
    int32 w = 1000;
    int32 h = 1000;
    int32 maxiter = 1000;
    int64 sum = 0;
    for (int32 y = 0; y < h; y = y + 1) {
        for (int32 x = 0; x < w; x = x + 1) {
            float64 cr = -2.0 + 3.0 * static_cast<float64>(x) / static_cast<float64>(w);
            float64 ci = -1.5 + 3.0 * static_cast<float64>(y) / static_cast<float64>(h);
            float64 zr = 0.0;
            float64 zi = 0.0;
            int32 iter = 0;
            while (iter < maxiter) {
                float64 zr2 = zr * zr;
                float64 zi2 = zi * zi;
                if (zr2 + zi2 > 4.0) {
                    break;
                }
                zi = 2.0 * zr * zi + ci;
                zr = zr2 - zi2 + cr;
                iter = iter + 1;
            }
            sum = sum + static_cast<int64>(iter);
        }
    }
    println("{}", sum);
    return 0;
}
