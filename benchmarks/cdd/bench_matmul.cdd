// Runtime benchmark: float64 multiply-add, cache-friendly i-k-j order.
// Pair: benchmarks/cpp/bench_matmul.cpp (same algorithm and result).
module bench_matmul;

int32 main() {
    int32 n = 768;
    float64* a = (float64*)malloc(n * n * 8);
    float64* b = (float64*)malloc(n * n * 8);
    float64* c = (float64*)malloc(n * n * 8);
    for (int32 i = 0; i < n * n; i = i + 1) {
        a[i] = static_cast<float64>(i % 7) * 0.5;
        b[i] = static_cast<float64>(i % 11) * 0.25;
    }
    for (int32 i = 0; i < n; i = i + 1) {
        for (int32 j = 0; j < n; j = j + 1) {
            c[i * n + j] = 0.0;
        }
        for (int32 k = 0; k < n; k = k + 1) {
            float64 aik = a[i * n + k];
            for (int32 j = 0; j < n; j = j + 1) {
                c[i * n + j] = c[i * n + j] + aik * b[k * n + j];
            }
        }
    }
    println("{}", static_cast<int64>(c[0] + c[n * n - 1]));
    free(a);
    free(b);
    free(c);
    return 0;
}
