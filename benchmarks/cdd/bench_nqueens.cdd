// Runtime benchmark: recursive backtracking, branch-heavy search, arrays.
// Pair: benchmarks/cpp/bench_nqueens.cpp (same algorithm and result).
module bench_nqueens;

int32 solutions;

bool safe(int32* cols, int32 row, int32 col) {
    for (int32 i = 0; i < row; i = i + 1) {
        int32 c = cols[i];
        if (c == col) {
            return false;
        }
        int32 d = row - i;
        if (c - col == d || col - c == d) {
            return false;
        }
    }
    return true;
}

void solve(int32* cols, int32 row, int32 n) {
    if (row == n) {
        solutions = solutions + 1;
        return;
    }
    for (int32 c = 0; c < n; c = c + 1) {
        if (safe(cols, row, c)) {
            cols[row] = c;
            solve(cols, row + 1, n);
        }
    }
}

int32 main() {
    int32 n = 13;
    int32* cols = (int32*)malloc(n * 4);
    solutions = 0;
    solve(cols, 0, n);
    println("{}", solutions);
    free(cols);
    return 0;
}
