// Runtime benchmark: byte-array traffic, nested loops, branch prediction.
// Pair: benchmarks/cpp/bench_sieve.cpp (same algorithm and result).
module bench_sieve;

int32 main() {
    int32 n = 200000000;
    uint8* s = (uint8*)malloc(n + 1);
    for (int32 i = 0; i <= n; i = i + 1) {
        s[i] = 1;
    }
    s[0] = 0;
    s[1] = 0;
    for (int32 i = 2; i * i <= n; i = i + 1) {
        if (s[i] == 1) {
            for (int32 j = i * i; j <= n; j = j + i) {
                s[j] = 0;
            }
        }
    }
    int32 count = 0;
    for (int32 i = 0; i <= n; i = i + 1) {
        count = count + s[i];
    }
    println("{}", count);
    free(s);
    return 0;
}
