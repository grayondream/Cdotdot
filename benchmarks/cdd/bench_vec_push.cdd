// stdlib benchmark: std::Vec<int32> growth through repeated push.
// Pair: benchmarks/cpp/bench_vec_push.cpp (same algorithm and result).
module bench_vec_push;

import std.vec;

int32 main() {
    std::Vec<int32> v = {};
    v.init();
    for (int32 i = 0; i < 32000000; i = i + 1) {
        v.push(i * 3);
    }
    int64 sum = 0;
    for (usize i = 0; i < v.len; i = i + 1) {
        sum = sum + static_cast<int64>(v.get(i));
    }
    println("{}", sum);
    v.destroy();
    return 0;
}
